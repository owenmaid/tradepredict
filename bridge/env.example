# Copy to .env (never commit it) or set these in your host's dashboard.

# Shared secret. Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Put the SAME value in Base44 Secrets as IBKR_BRIDGE_KEY.
BRIDGE_API_KEY=

# oauth (recommended) or gateway
IBKR_MODE=oauth

# ---- oauth mode: values from the IBKR OAuth 1.0a self-service portal ----
# See https://github.com/Voyz/ibind/wiki/OAuth-1.0a for how to generate these.
IBIND_USE_OAUTH=True
IBIND_OAUTH1A_CONSUMER_KEY=
IBIND_OAUTH1A_ACCESS_TOKEN=
IBIND_OAUTH1A_ACCESS_TOKEN_SECRET=
IBIND_OAUTH1A_DH_PRIME=
# Either paste the key contents...
IBIND_OAUTH1A_ENCRYPTION_KEY=
IBIND_OAUTH1A_SIGNATURE_KEY=
# ...or point at files mounted into the container:
# IBIND_OAUTH1A_ENCRYPTION_KEY_FP=/secrets/private_encryption.pem
# IBIND_OAUTH1A_SIGNATURE_KEY_FP=/secrets/private_signature.pem

# ---- gateway mode: the Client Portal Gateway on the same machine ----
# IBKR_GATEWAY_URL=https://localhost:5000/v1/api/
